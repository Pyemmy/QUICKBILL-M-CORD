# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated list of admin email addresses authorized for CAC verification.
ADMIN_EMAILS="owoadeopeyemi11@gmail.com,admin@quickbill.ng"

# Vercel frontend origin, for example: https://quickbill-five.vercel.app
FRONTEND_URL=""

# Optional persistent database directory. Render disk example: /var/data
DATA_DIR="data"

# PARSER_SERVICE_URL: Optional external parser endpoint. Falls back to Gemini on failure.
PARSER_SERVICE_URL=""

